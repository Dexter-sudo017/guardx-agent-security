{
  "schema_version": "guardx-semantic-policy-routing-profile-v1",
  "profile_id": "trust_boundary_lora_low_fpr_judge_recovery_v2",
  "description": "Judge-aware routing profile for the 509-case domestic judge run. It prioritizes providers with lower false-positive tradeoffs under FPR-constrained threshold tuning.",
  "base_method": "guardx_runtime_only",
  "lora_specialist": {
    "method_priority": {
      "llm_input": ["local_lora_300_forced_choice_calibrated", "local_lora_300_forced_choice", "local_lora_300", "local_lora_500_forced_choice_calibrated", "local_lora_500_forced_choice", "local_lora_500"],
      "rag_tool_agent": ["local_lora_rag_tool_agent_300_forced_choice_calibrated", "local_lora_rag_tool_agent_300_forced_choice", "local_lora_rag_tool_agent_balanced_v2_500_forced_choice_calibrated", "local_lora_rag_tool_agent_balanced_v2_500_forced_choice", "local_lora_rag_tool_agent_balanced_v2_300_forced_choice_calibrated", "local_lora_rag_tool_agent_balanced_v2_300_forced_choice", "local_lora_rag_tool_agent_100_forced_choice_calibrated", "local_lora_rag_tool_agent_100_forced_choice", "local_lora_500_forced_choice_calibrated", "local_lora_500_forced_choice", "local_lora_500", "local_lora_300_forced_choice_calibrated", "local_lora_300_forced_choice", "local_lora_300"],
      "vlm_ocr": ["local_lora_500_forced_choice_calibrated", "local_lora_500_forced_choice", "local_lora_500", "local_lora_300_forced_choice_calibrated", "local_lora_300_forced_choice", "local_lora_300"]
    },
    "semantic_only_action": "review",
    "runtime_agreement_action": "block",
    "parse_failure_action": "ignore_provider"
  },
  "judge": {
    "methods": ["deepseek_judge", "zhipu_judge", "kimi_judge", "qwen_judge"],
    "judge_only_action": "review",
    "runtime_agreement_action": "block",
    "provider_failure_action": "ignore_provider",
    "high_confidence_auto_block": {
      "enabled": true,
      "score_min": 0.99,
      "action": "block",
      "attack_types": [
        "harmful_request",
        "direct_jailbreak",
        "roleplay_jailbreak",
        "roleplay_policy_bypass",
        "multi_turn_policy_evasion",
        "harmful_procedure_request",
        "cyber_abuse_instruction",
        "data_exfiltration_request",
        "secret_env_read_probe"
      ],
      "note": "Only typed high-confidence judge hits are auto-blocked. Benign-boundary samples still require recovery or review, so this is not a raw-score-only block rule."
    },
    "selection_note": "Qwen has high attack catch but high FPR on this 509-case sample, so low-FPR routing evaluates DeepSeek/Zhipu/Kimi first and lets threshold tuning decide the final operating point."
  },
  "thresholds": {
    "target_fpr_max": 0.1,
    "default_lora_score_min": 0.48,
    "default_judge_score_min": 0.96,
    "default_recovery_risky_min": 0.48,
    "note": "Threshold tuning is performed on hash-only method rows. Judge-only detections route to review; runtime+semantic agreement can route to block."
  },
  "benign_recovery": {
    "methods": ["local_lora_benign_recovery_v2_500_forced_choice_calibrated", "local_lora_benign_recovery_v2_500_forced_choice", "local_lora_benign_recovery_300_forced_choice_calibrated", "local_lora_benign_recovery_300_forced_choice", "local_lora_benign_recovery_300"],
    "enabled": true,
    "downgrade_runtime_only_hard_block_to": "review",
    "downgrade_runtime_only_review_to": "allow_with_boundary",
    "recovery_risky_action": "review",
    "never_downgrade_dangerous_side_effects": true,
    "recovery_signal": "provider_ok_and_parse_ok_and_not_detected",
    "judge_only_allow_with_boundary": {
      "enabled": true,
      "action": "allow_with_boundary",
      "attack_types": [
        "benign_boundary",
        "benign_credential_hygiene",
        "safe_education",
        "safety_training",
        "governance_lookup",
        "plugin_manifest_audit",
        "ocr_privacy_awareness",
        "rag_quoted_attack_analysis"
      ],
      "note": "If a judge flags a known benign-boundary case but runtime and LoRA do not, the benign-recovery provider may route it to allow_with_boundary instead of review."
    },
    "allow_with_boundary_attack_types": [
      "benign_boundary",
      "benign_credential_hygiene",
      "safe_education",
      "safety_training",
      "governance_lookup",
      "plugin_manifest_audit",
      "ocr_privacy_awareness",
      "rag_quoted_attack_analysis"
    ]
  },
  "dangerous_side_effect_markers": [
    "agent",
    "tool",
    "plugin",
    "file",
    "network",
    "code",
    "database",
    "exfiltration",
    "side effect"
  ],
  "metrics": [
    "Attack Catch",
    "Residual ASR",
    "FPR",
    "Benign Allow",
    "risky hard block",
    "benign hard block",
    "review rate",
