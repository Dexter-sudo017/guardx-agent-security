{
  "schema_version": "guardx-deployment-security-policy-v1",
  "transport": {
    "tls_required_for_non_localhost": true,
    "allowed_plain_http_hosts": ["127.0.0.1", "localhost"],
    "recommended_reverse_proxy": ["Caddy", "Nginx", "Traefik"]
  },
  "authentication": {
    "web_token_required": true,
    "proxy_token_required": true,
    "action_callback_token_required": true,
    "rotation_days": 7,
    "store_tokens_in_env_only": true
  },
  "audit_retention": {
    "default_days": 30,
    "redact_secrets_in_logs": true,
    "store_raw_high_risk_prompts": false,
    "store_prompt_hashes": true
  },
  "rate_limit": {
    "enabled": true,
    "default_requests_per_minute": 120,
    "action_guard_requests_per_minute": 240
  },
  "failure_policy": {
    "default_action_guard_fail_closed": true,
    "default_rag_proxy_fail_closed": true,
    "allow_fail_open_only_for_benign_dev_profiles": false
  },
  "replay_access_control": {
    "token_required": true,
    "export_requires_local_operator": true,
    "mask_synthetic_canaries": false,
    "mask_real_credentials": true
  }
}
