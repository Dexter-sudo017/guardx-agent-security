# Copy this file to `.env.guardx_judge.local` in the repository root.
# `.env.*` files are ignored by Git. Keep real keys out of commits,
# terminal history, screenshots, and experiment reports.
#
# Preferred variable names are GUARDX_* below. The domestic judge runner also
# accepts common local aliases and maps them in memory:
# - Qwen: DASHSCOPE_API_KEY, BAILIAN_API_KEY, QWEN_API_KEY, TONGYI_API_KEY
# - DeepSeek: DEEPSEEK_API_KEY
# - Zhipu/GLM: ZAI_API_KEY, ZHIPU_API_KEY, GLM_API_KEY, BIGMODEL_API_KEY
# - Kimi/Moonshot: MOONSHOT_API_KEY, KIMI_API_KEY

GUARDX_QWEN_JUDGE_API_KEY=<dashscope_or_bailian_api_key>
GUARDX_QWEN_JUDGE_MODEL=qwen-plus

GUARDX_DEEPSEEK_JUDGE_API_KEY=<deepseek_api_key>
GUARDX_DEEPSEEK_JUDGE_MODEL=deepseek-chat

GUARDX_ZHIPU_JUDGE_API_KEY=<zhipu_api_key>
GUARDX_ZHIPU_JUDGE_MODEL=glm-4-flash

GUARDX_KIMI_JUDGE_API_KEY=<moonshot_api_key>
GUARDX_KIMI_JUDGE_MODEL=moonshot-v1-8k
